rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /cadastros/{cadastroId} {
      allow read: if true;
      allow write: if isValidId(cadastroId);
    }

    match /entradas/{entradaId} {
      allow read: if true;
      allow write: if isValidId(entradaId);
    }

    match /saidas/{saidaId} {
      allow read: if true;
      allow write: if isValidId(saidaId);
    }
  }
}
